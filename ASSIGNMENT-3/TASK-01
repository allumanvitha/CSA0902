4. Complete Java Source Code
The program below demonstrates:
- try block for withdrawal processing.
- Multiple catch blocks for different failures.
- Multi-catch for invalid input.
- Custom checked exception for insufficient balance.
- finally block for transaction completion.
- File handling for the card reader.

import java.util.Scanner;
import java.io.File;
import java.io.FileNotFoundException;
import java.io.IOException;
import java.util.InputMismatchException;

// Custom checked exception
class InsufficientBalanceException extends Exception {
    InsufficientBalanceException(String message) {
        super(message);
    }
}

public class ATM {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        double balance = 5000;

        try {
            // Check card reader file
            File file = new File("cardreader.txt");
            Scanner reader = new Scanner(file);
            reader.close();

            System.out.print("Enter account number: ");
            long account = sc.nextLong();

            if (account != 123456) {
                throw new IllegalArgumentException(
                    "Invalid account number");
            }

            System.out.print("Enter withdrawal amount: ");
            double amount = sc.nextDouble();

            if (amount <= 0) {
                throw new IllegalArgumentException(
                    "Amount must be positive");
            }

            if (amount > balance) {
                throw new InsufficientBalanceException(
                    "Insufficient account balance");
            }

            balance = balance - amount;

            System.out.println("Withdrawal successful!");
            System.out.println("Cash dispensed: " + amount);
            System.out.println("Remaining balance: " + balance);

        }
        catch (InputMismatchException | IllegalArgumentException e) {
            System.out.println("Invalid input: " + e.getMessage());
        }
        catch (InsufficientBalanceException e) {
            System.out.println("Transaction failed: " + e.getMessage());
        }
        catch (FileNotFoundException e) {
            System.out.println("Card reader error: File not found.");
        }
        catch (IOException e) {
            System.out.println("File reading error: " + e.getMessage());
        }
        finally {
            System.out.println("ATM transaction process completed.");
            sc.close();
        }
    }
}



