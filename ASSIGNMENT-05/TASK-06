B1.4 – Measure Growth (2 Marks)
Aim: Measure how the search time increases when the number of bus-pass records grows from 1,000 to 100,000.
Java benchmark code
Save this as FindTest.java.

import java.io.*;
import java.nio.file.*;

public class FindTest {

    static String[] find(String file, String id)
            throws Exception {

        try (BufferedReader r =
                Files.newBufferedReader(Path.of(file))) {

            String line;

            while ((line = r.readLine()) != null) {

                String[] fields = line.split(",", -1);

                if (fields.length != 5) {
                    continue;
                }

                if (fields[0].equals(id)) {
                    return fields;
                }
            }
        }

        return null;
    }

    static void createRecords(String file, int n)
            throws Exception {

        try (BufferedWriter w =
                Files.newBufferedWriter(Path.of(file))) {

            for (int i = 1; i <= n; i++) {

                w.write("P" + i + ",REG" + i
                        + ",Student" + i + ",12,4500");
                w.newLine();
            }
        }
    }

    public static void main(String[] args) throws Exception {

        int[] sizes = {1000, 10000, 50000, 100000};

        for (int n : sizes) {

            String file = "passes.txt";

            createRecords(file, n);

            String searchId = "P" + n;

            // Warm-up
            find(file, searchId);

            long start = System.nanoTime();

            for (int i = 0; i < 5; i++) {
                find(file, searchId);
            }

            long end = System.nanoTime();

            double averageTime =
                    (end - start) / 5_000_000.0;

            System.out.println("Records: " + n);
            System.out.println("Average search time: "
                    + averageTime + " ms");
            System.out.println();
        }
    }
}



