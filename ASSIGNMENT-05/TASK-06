B1.3 – Measure the Effect of Buffering (2 Marks)
Aim: Compare the time taken by unbuffered and buffered file reading for 1 MB, 10 MB and 50 MB files.
Java benchmark code
Save this as BufferTest.java.

import java.io.*;
import java.nio.file.*;

public class BufferTest {

    static long countUnbuffered(String file) throws Exception {
        long lines = 0;

        try (FileInputStream in = new FileInputStream(file)) {
            int ch;

            while ((ch = in.read()) != -1) {
                if (ch == '\n') {
                    lines++;
                }
            }
        }

        return lines;
    }

    static long countBuffered(String file) throws Exception {
        long lines = 0;

        try (BufferedInputStream in =
                new BufferedInputStream(new FileInputStream(file))) {

            int ch;

            while ((ch = in.read()) != -1) {
                if (ch == '\n') {
                    lines++;
                }
            }
        }

        return lines;
    }

    static void createFile(String file, int sizeMB)
            throws Exception {

        long target = sizeMB * 1024L * 1024L;
        long written = 0;

        try (BufferedWriter out =
                Files.newBufferedWriter(Path.of(file))) {

            while (written < target) {
                String line = "Attendance record 123456789\n";
                out.write(line);
                written += line.getBytes().length;
            }
        }
    }

    public static void main(String[] args) throws Exception {

        int[] sizes = {1, 10, 50};

        for (int size : sizes) {

            String file = "attendance" + size + ".txt";

            createFile(file, size);

            // Warm-up
            countBuffered(file);

            long start = System.nanoTime();
            countUnbuffered(file);
            long end = System.nanoTime();

            double unbufferedTime =
                    (end - start) / 1_000_000.0;

            start = System.nanoTime();
            countBuffered(file);
            end = System.nanoTime();

            double bufferedTime =
                    (end - start) / 1_000_000.0;

            System.out.println(size + " MB");
            System.out.println("Unbuffered: "
                    + unbufferedTime + " ms");
            System.out.println("Buffered: "
                    + bufferedTime + " ms");
            System.out.println();
        }
    }
}



