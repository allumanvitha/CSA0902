Task 5.1 – Four Implementations (3 Marks)
The currency converter has:
- Amount input field.
- Target currency selection (USD or EUR).
- Convert button.
- Result label.
- Window closing operation using WindowAdapter.
The same conversion logic can be implemented in four different event-handling styles.
Common conversion formula
For the example, assume:
- 1 INR = 0.012 USD
- 1 INR = 0.011 EUR
\[
\text{Converted Amount} = \text{INR Amount} \times \text{Currency Rate}
\]

(a) Frame implements ActionListener
In this method, the JFrame itself handles the button event.

import java.awt.*;
import java.awt.event.*;
import javax.swing.*;

public class ConverterA extends JFrame
        implements ActionListener {

    JTextField amount = new JTextField(10);

    JComboBox<String> target =
        new JComboBox<>(new String[]{"USD", "EUR"});

    JLabel result = new JLabel(" ");

    JButton convertButton = new JButton("Convert");

    ConverterA() {

        setTitle("Currency Converter");
        setLayout(new FlowLayout());

        add(new JLabel("INR"));
        add(amount);
        add(target);
        add(convertButton);
        add(result);

        convertButton.addActionListener(this);

        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent e) {
                dispose();
            }
        });

        setSize(350, 150);
        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {
        convert();
    }

    void convert() {
        try {
            double value =
                Double.parseDouble(amount.getText());

            String currency =
                (String) target.getSelectedItem();

            double rate =
                currency.equals("USD") ? 0.012 : 0.011;

            double answer = value * rate;

            result.setText(String.format("%.2f", answer));

        } catch (NumberFormatException e) {
            result.setText("Invalid amount");
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() ->
            new ConverterA());
    }
}



