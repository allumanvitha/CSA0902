Complete the Code – TODO 1 and TODO 2 (Lambda Version)
The following is the completed version of the question's given Converter program. It uses one lambda listener for both the Convert button and Enter key.

import java.awt.FlowLayout;
import java.awt.event.ActionListener;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;
import javax.swing.*;

public class Converter extends JFrame {

    private final JTextField amount = new JTextField(10);

    private final JComboBox<String> target =
        new JComboBox<>(new String[]{"USD", "EUR"});

    private final JLabel result = new JLabel(" ");

    private static double rate(String currency) {
        return currency.equals("USD") ? 0.012 : 0.011;
    }

    public Converter() {

        super("Currency Converter");

        setLayout(new FlowLayout());

        JButton convertButton = new JButton("Convert");

        add(new JLabel("INR"));
        add(amount);
        add(target);
        add(convertButton);
        add(result);

        // TODO 1: One lambda listener for both triggers
        ActionListener convertAction = e -> convert();

        convertButton.addActionListener(convertAction);
        amount.addActionListener(convertAction);

        // Window closing
        addWindowListener(new WindowAdapter() {
            @Override
            public void windowClosing(WindowEvent e) {
                dispose();
            }
        });

        setDefaultCloseOperation(
            JFrame.DO_NOTHING_ON_CLOSE);

        pack();
        setLocationRelativeTo(null);
    }

    private void convert() {

        // TODO 2: Validate and display conversion
        try {
            double value =
                Double.parseDouble(amount.getText().trim());

            if (!Double.isFinite(value) || value < 0) {
                throw new NumberFormatException();
            }

            String currency =
                (String) target.getSelectedItem();

            double converted = value * rate(currency);

            String message = String.format(
                "%.2f %s", converted, currency);

            result.setText(message);

            JOptionPane.showMessageDialog(
                this,
                "Converted Amount: " + message,
                "Conversion Result",
                JOptionPane.INFORMATION_MESSAGE
            );

        } catch (NumberFormatException e) {

            result.setText("Invalid amount");

            JOptionPane.showMessageDialog(
                this,
                "Invalid amount",
                "Input Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() ->
            new Converter().setVisible(true));
    }
}



