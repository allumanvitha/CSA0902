3. SIMATS-style pseudocode
Algorithm: Fee Payment Processing
1. START
2. Read registration number and payment amount from the GUI.
3. IF registration number is empty OR amount is invalid OR amount is less than or equal to zero:
   - Display an error message.
   - STOP the payment operation.
4. Create a background payment task.
5. Call the FeeService payment method.
6. Establish a database connection.
7. Prepare an SQL INSERT statement using parameters.
8. Execute the payment insertion.
9. IF the payment is successful:
   - Generate and store receipt details.
   - Display payment success message.
10. ELSE:
    - Display the payment failure message.
11. Close database resources.
12. STOP.
4. Java implementation using Swing
Save the program as FeePaymentApp.java.

Note: This example uses JDBC and MySQL. Change the database URL, username, and password according to your setup. Create the fees table before running the program.

import javax.swing.*;
import java.awt.*;
import java.sql.*;

// Separate class for payment logic
class FeeService {

    private final String URL =
        "jdbc:mysql://localhost:3306/college";
    private final String USER = "root";
    private final String PWD = "password";

    public String pay(String regNo, double amount)
            throws Exception {

        if (regNo == null || regNo.trim().isEmpty()) {
            throw new IllegalArgumentException(
                "Registration number is required");
        }

        if (!Double.isFinite(amount) || amount <= 0) {
            throw new IllegalArgumentException(
                "Enter a valid positive amount");
        }

        String sql =
            "INSERT INTO fees(reg_no, amount) VALUES (?, ?)";

        try (Connection con =
                 DriverManager.getConnection(URL, USER, PWD);
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, regNo.trim());
            ps.setDouble(2, amount);

            ps.executeUpdate();

            return "Payment Successful!\n"
                 + "Registration No: " + regNo
                 + "\nAmount: Rs. " + amount;
        }
    }
}

// GUI class
public class FeePaymentApp extends JFrame {

    JTextField regNo = new JTextField(15);
    JTextField amount = new JTextField(15);

    JButton pay = new JButton("Pay");
    JButton clear = new JButton("Clear");
    JButton receipt = new JButton("Receipt");

    FeeService service = new FeeService();
    String lastReceipt = null;

    FeePaymentApp() {

        setTitle("Student Fee Payment");
        setSize(350, 250);
        setLayout(new GridLayout(4, 2, 5, 5));

        add(new JLabel("Registration Number:"));
        add(regNo);

        add(new JLabel("Amount:"));
        add(amount);

        add(pay);
        add(clear);
        add(receipt);

        // Separate listener for Pay
        pay.addActionListener(e -> makePayment());

        // Separate listener for Clear
        clear.addActionListener(e -> {
            regNo.setText("");
            amount.setText("");
        });

        // Separate listener for Receipt
        receipt.addActionListener(e -> {
            if (lastReceipt == null) {
                JOptionPane.showMessageDialog(
                    this, "No payment receipt available");
            } else {
                JOptionPane.showMessageDialog(
                    this, lastReceipt);
            }
        });

        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setVisible(true);
    }

    void makePayment() {

        String r = regNo.getText();
        String a = amount.getText();

        double value;

        try {
            value = Double.parseDouble(a);
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(
                this, "Enter a valid amount");
            return;
        }

        pay.setEnabled(false);

        // Run database operation in background
        SwingWorker<String, Void> worker =
            new SwingWorker<String, Void>() {

            protected String doInBackground()
                    throws Exception {
                return service.pay(r, value);
            }

            protected void done() {
                try {
                    lastReceipt = get();

                    JOptionPane.showMessageDialog(
                        FeePaymentApp.this, lastReceipt);

                } catch (Exception ex) {
                    JOptionPane.showMessageDialog(
                        FeePaymentApp.this,
                        "Payment Failed: " + ex.getMessage());

                } finally {
                    pay.setEnabled(true);
                }
            }
        };

        worker.execute();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() ->
            new FeePaymentApp());
    }
}



