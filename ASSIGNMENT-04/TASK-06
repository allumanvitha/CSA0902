    // REGISTER USING SWINGWORKER
    void registerStudent() {
        Registration r = new Registration(
            idField.getText().trim(),
            nameField.getText().trim(),
            (String) departmentBox.getSelectedItem(),
            (String) eventBox.getSelectedItem()
        );

        registerButton.setEnabled(false);

        new SwingWorker<String, Void>() {
            protected String doInBackground() throws Exception {
                return service.register(r);
            }

            protected void done() {
                registerButton.setEnabled(true);
                try {
                    String message = get();
                    JOptionPane.showMessageDialog(
                        EventRegistrationApp.this, message);

                    if (message.equals("Registration successful!")) {
                        idField.setText("");
                        nameField.setText("");
                        departmentBox.setSelectedIndex(0);
                        eventBox.setSelectedIndex(0);
                        page = 0;
                        loadPage();
                    }
                } catch (Exception ex) {
                    showError(ex);
                }
            }
        }.execute();
    }

    // FILTER AND LOAD ONE PAGE
    void loadPage() {
        String event = (String) filterBox.getSelectedItem();
        int offset = page * PAGE_SIZE;

        filterButton.setEnabled(false);
        nextButton.setEnabled(false);
        previousButton.setEnabled(false);
        pageLabel.setText("Loading...");

        new SwingWorker<java.util.List<String[]>, Void>() {
            protected java.util.List<String[]> doInBackground()
                    throws Exception {
                return service.filter(event, PAGE_SIZE, offset);
            }

            protected void done() {
                filterButton.setEnabled(true);
                previousButton.setEnabled(page > 0);

                try {
                    java.util.List<String[]> rows = get();

                    model.setRowCount(0);
                    for (String[] row : rows) {
                        model.addRow(row);
                    }

                    pageLabel.setText("Page " + (page + 1));
                    nextButton.setEnabled(rows.size() == PAGE_SIZE);

                    if (rows.isEmpty() && page > 0) {
                        page--;
                        loadPage();
                    }

                } catch (Exception ex) {
                    pageLabel.setText("Load failed");
                    showError(ex);
                }
            }
        }.execute();
    }

    // EXPORT DISPLAYED PAGE TO CSV
    void exportCSV() {
        JFileChooser chooser = new JFileChooser();
        chooser.setSelectedFile(
            new File("event_registrations.csv"));

        if (chooser.showSaveDialog(this) !=
                JFileChooser.APPROVE_OPTION) {
            return;
        }

        try (PrintWriter out = new PrintWriter(
                new FileWriter(chooser.getSelectedFile()))) {

            for (int c = 0; c < model.getColumnCount(); c++) {
                if (c > 0) out.print(",");
                out.print(model.getColumnName(c));
            }
            out.println();

            for (int r = 0; r < model.getRowCount(); r++) {
                for (int c = 0; c < model.getColumnCount(); c++) {
                    if (c > 0) out.print(",");
                    String value = String.valueOf(
                        model.getValueAt(r, c));
                    out.print("\"" + value.replace("\"", "\"\"") + "\"");
                }
                out.println();
            }

            JOptionPane.showMessageDialog(this,
                "Current page exported successfully!");

        } catch (IOException ex) {
            showError(ex);
        }
    }

    void showError(Exception ex) {
        Throwable cause = ex;
        while (cause.getCause() != null) {
            cause = cause.getCause();
        }

        JOptionPane.showMessageDialog(this,
            "Error: " + cause.getMessage(),
            "Application Error",
            JOptionPane.ERROR_MESSAGE);
    }

