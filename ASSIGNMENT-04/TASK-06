import java.awt.*;
import java.awt.event.*;
import java.io.*;
import java.sql.*;
import java.util.*;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;

// DATABASE CONNECTION
class DB {
    static Connection getConnection() throws SQLException {
        return DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/campus_events",
            "root",
            "YOUR_MYSQL_PASSWORD"
        );
    }
}

// REGISTRATION MODEL
class Registration {
    String id, name, department, event;

    Registration(String id, String name,
                 String department, String event) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.event = event;
    }
}

// JDBC DATA ACCESS LAYER
class RegistrationDAO {

    boolean insert(Registration r) throws SQLException {
        String sql = "INSERT INTO registrations " +
            "(student_id, student_name, department, event_name) " +
            "VALUES (?, ?, ?, ?)";

        try (Connection con = DB.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, r.id);
            ps.setString(2, r.name);
            ps.setString(3, r.department);
            ps.setString(4, r.event);
            ps.executeUpdate();
            return true;

        } catch (SQLIntegrityConstraintViolationException e) {
            return false;
        }
    }

    java.util.List<String[]> getPage(
            String event, int limit, int offset) throws SQLException {

        java.util.List<String[]> list = new ArrayList<>();

        String sql = "SELECT registration_id, student_id, " +
            "student_name, department, event_name, registration_date " +
            "FROM registrations " +
            "WHERE (? = 'All Events' OR event_name = ?) " +
            "ORDER BY registration_id " +
            "LIMIT ? OFFSET ?";

        try (Connection con = DB.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, event);
            ps.setString(2, event);
            ps.setInt(3, limit);
            ps.setInt(4, offset);

            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    list.add(new String[] {
                        rs.getString("registration_id"),
                        rs.getString("student_id"),
                        rs.getString("student_name"),
                        rs.getString("department"),
                        rs.getString("event_name"),
                        rs.getString("registration_date")
                    });
                }
            }
        }
        return list;
    }
}

// SERVICE LAYER
class RegistrationService {
    RegistrationDAO dao = new RegistrationDAO();

    String register(Registration r) throws SQLException {
        if (r.id.trim().isEmpty() ||
            r.name.trim().isEmpty()) {
            return "Please fill all required fields.";
        }

        if (!r.id.matches("[A-Za-z0-9]{3,20}")) {
            return "Invalid student ID.";
        }

        if (r.department.equals("Select Department") ||
            r.event.equals("Select Event")) {
            return "Please select department and event.";
        }

        if (dao.insert(r)) {
            return "Registration successful!";
        }

        return "Duplicate registration! You already registered for this event.";
    }

    java.util.List<String[]> filter(
            String event, int limit, int offset) throws SQLException {
        return dao.getPage(event, limit, offset);
    }
}

