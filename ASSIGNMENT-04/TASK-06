5.4 Improved Export – Export All Filtered Registrations
To export the complete filtered list rather than only the visible page, replace the exportCSV() method in the program with this version. It retrieves all matching records page by page in the background.

void exportCSV() {
    JFileChooser chooser = new JFileChooser();
    chooser.setSelectedFile(new File("event_registrations.csv"));

    if (chooser.showSaveDialog(this) != JFileChooser.APPROVE_OPTION) {
        return;
    }

    File file = chooser.getSelectedFile();
    String event = (String) filterBox.getSelectedItem();

    exportButton.setEnabled(false);

    new SwingWorker<Void, Void>() {
        protected Void doInBackground() throws Exception {
            try (PrintWriter out = new PrintWriter(new FileWriter(file))) {

                out.println("ID,Student ID,Name,Department,Event,Date");

                int offset = 0;
                java.util.List<String[]> rows;

                do {
                    rows = service.filter(event, PAGE_SIZE, offset);

                    for (String[] row : rows) {
                        for (int c = 0; c < row.length; c++) {
                            if (c > 0) out.print(",");
                            out.print("\"" +
                                row[c].replace("\"", "\"\"") + "\"");
                        }
                        out.println();
                    }

                    offset += PAGE_SIZE;

                } while (rows.size() == PAGE_SIZE);
            }
            return null;
        }

        protected void done() {
            exportButton.setEnabled(true);
            try {
                get();
                JOptionPane.showMessageDialog(
                    EventRegistrationApp.this,
                    "All filtered registrations exported successfully!");
            } catch (Exception ex) {
                showError(ex);
            }
        }
    }.execute();
}
This version exports every matching record and does not freeze the window while retrieving or writing the file.
