Task 3.3 – Implement the Screen (3 Marks)
Java Swing program

Save the file as LibrarySearch.java.

import javax.swing.*;
import java.awt.*;

public class LibrarySearch extends JFrame {

    JTextField searchField;
    JComboBox<String> category;
    JButton searchButton;
    JButton prevButton, nextButton, reserveButton;
    JTextArea results;
    JLabel status;

    LibrarySearch() {

        setTitle("Campus Library Search");
        setSize(700, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        // Main layout
        setLayout(new BorderLayout(5, 5));

        // Title panel
        JPanel titlePanel = new JPanel();
        titlePanel.setLayout(new FlowLayout());
        titlePanel.add(new JLabel("CAMPUS LIBRARY SEARCH"));

        // Search panel
        JPanel searchPanel = new JPanel();
        searchPanel.setLayout(new FlowLayout());

        searchField = new JTextField(20);

        String items[] = {
            "All", "Books", "Journals", "Articles"
        };

        category = new JComboBox<>(items);
        searchButton = new JButton("Search");

        searchPanel.add(searchField);
        searchPanel.add(category);
        searchPanel.add(searchButton);

        // Top panel
        JPanel topPanel = new JPanel(new BorderLayout());
        topPanel.add(titlePanel, BorderLayout.NORTH);
        topPanel.add(searchPanel, BorderLayout.SOUTH);

        // Results area
        results = new JTextArea();
        results.setEditable(false);
        results.setText("Search results will appear here.");

        JScrollPane scrollPane = new JScrollPane(results);

        // Bottom navigation panel
        JPanel buttonPanel = new JPanel();
        buttonPanel.setLayout(new FlowLayout());

        prevButton = new JButton("Prev");
        nextButton = new JButton("Next");
        reserveButton = new JButton("Reserve");

        buttonPanel.add(prevButton);
        buttonPanel.add(nextButton);
        buttonPanel.add(reserveButton);

        // Status message
        status = new JLabel("Status: Ready");

        // Bottom panel
        JPanel bottomPanel = new JPanel(new BorderLayout());
        bottomPanel.add(buttonPanel, BorderLayout.CENTER);
        bottomPanel.add(status, BorderLayout.SOUTH);

        // Add panels to main frame
        add(topPanel, BorderLayout.NORTH);
        add(scrollPane, BorderLayout.CENTER);
        add(bottomPanel, BorderLayout.SOUTH);

        // Search event
        searchButton.addActionListener(e -> {
            String text = searchField.getText();

            if (text.trim().isEmpty()) {
                status.setText("Status: Enter search text");
            } else {
                results.setText(
                    "Searching for: " + text +
                    "\nCategory: " + category.getSelectedItem()
                );

                status.setText("Status: Search completed");
            }
        });

        // Previous button
        prevButton.addActionListener(e ->
            status.setText("Status: Previous page selected"));

        // Next button
        nextButton.addActionListener(e ->
            status.setText("Status: Next page selected"));

        // Reserve button
        reserveButton.addActionListener(e ->
            status.setText("Status: Reservation requested"));

        setLocationRelativeTo(null);
        setVisible(true);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() ->
            new LibrarySearch());
    }
}



