4. Java implementation
The following program compares all three Map implementations using the same medicine records.

To make the report-order comparison meaningful, medicines are inserted in descending code order. This allows us to check whether each map produces the required sorted or insertion order.


java

import java.util.*;

class Medicine {
    String code;
    String name;
    int stock;

    Medicine(String code, String name, int stock) {
        this.code = code;
        this.name = name;
        this.stock = stock;
    }

    @Override
    public String toString() {
        return code + " " + name + " Stock: " + stock;
    }
}

public class PharmacyBenchmark {

    static final int LOOKUPS = 100000;
    static final int ROUNDS = 5;

    static volatile long resultHolder;

    static String code(int i) {
        return String.format("MED%06d", i);
    }

    static Medicine createMedicine(int i) {
        return new Medicine(
                code(i),
                "Medicine" + i,
                100 + i % 500
        );
    }

    static HashMap<String, Medicine> createHashMap(int n) {
        HashMap<String, Medicine> map = new HashMap<>();

        for (int i = n - 1; i >= 0; i--) {
            Medicine m = createMedicine(i);
            map.put(m.code, m);
        }

        return map;
    }

    static TreeMap<String, Medicine> createTreeMap(int n) {
        TreeMap<String, Medicine> map = new TreeMap<>();

        for (int i = n - 1; i >= 0; i--) {
            Medicine m = createMedicine(i);
            map.put(m.code, m);
        }

        return map;
    }

    static LinkedHashMap<String, Medicine>
    createLinkedHashMap(int n) {

        LinkedHashMap<String, Medicine> map =
                new LinkedHashMap<>();

        for (int i = n - 1; i >= 0; i--) {
            Medicine m = createMedicine(i);
            map.put(m.code, m);
        }

        return map;
    }

    // Measure average execution time
    static double measure(Runnable task) {

        // Warm-up
        task.run();

        long total = 0;

        for (int r = 0; r < ROUNDS; r++) {
            long start = System.nanoTime();

            task.run();

            long end = System.nanoTime();

            total += end - start;
        }

        return (double) total / ROUNDS;
    }

    // 100,000 lookups
    static double lookupTest(
            Map<String, Medicine> map,
            int n) {

        return measure(() -> {

            long sum = 0;

            for (int i = 0; i < LOOKUPS; i++) {

                int index = i % n;

                Medicine m = map.get(code(index));

                if (m != null)
                    sum += m.stock;
            }

            resultHolder = sum;
        });
    }

    // Code-order report
    static double codeReport(
            Map<String, Medicine> map,
            boolean alreadySorted) {

        return measure(() -> {

            long sum = 0;

            if (alreadySorted) {

                for (Map.Entry<String, Medicine> entry
                        : map.entrySet()) {

                    sum += entry.getValue().stock;
                }

            } else {

                List<String> keys =
                        new ArrayList<>(map.keySet());

                Collections.sort(keys);

                for (String key : keys) {
                    sum += map.get(key).stock;
                }
            }

            resultHolder = sum;
        });
    }

    // Insertion-order report
    static double insertionReport(
            Map<String, Medicine> map,
            List<String> insertionOrder,
            boolean preservesInsertionOrder) {

        return measure(() -> {

            long sum = 0;

            if (preservesInsertionOrder) {

                for (Medicine m : map.values()) {
                    sum += m.stock;
                }

            } else {

                // Extra insertion-order information required
                for (String key : insertionOrder) {
                    Medicine m = map.get(key);
                    sum += m.stock;
                }
            }

            resultHolder = sum;
        });
    }

    static boolean checkCodeOrder(
            Map<String, Medicine> map) {

        String previous = null;

        for (String key : map.keySet()) {

            if (previous != null &&
                    previous.compareTo(key) > 0) {
                return false;
            }

            previous = key;
        }

        return true;
    }

    static boolean checkInsertionOrder(
            Map<String, Medicine> map,
            List<String> expected) {

        Iterator<String> actual =
                map.keySet().iterator();

        for (String key : expected) {

            if (!actual.hasNext())
                return false;

            if (!key.equals(actual.next()))
                return false;
        }

        return !actual.hasNext();
    }

    static void runTest(int n) {

        System.out.println("\n================================");
        System.out.println("MEDICINE COUNT: " + n);
        System.out.println("================================");

        HashMap<String, Medicine> hash =
                createHashMap(n);

        TreeMap<String, Medicine> tree =
                createTreeMap(n);

        LinkedHashMap<String, Medicine> linked =
                createLinkedHashMap(n);

        // Store the actual insertion sequence
        List<String> insertionOrder =
                new ArrayList<>();

        for (int i = n - 1; i >= 0; i--) {
            insertionOrder.add(code(i));
        }

        System.out.println("\nLOOKUP - 100000 OPERATIONS");

        System.out.printf(
                "HashMap: %.2f ms%n",
                lookupTest(hash, n) / 1_000_000);

        System.out.printf(
                "TreeMap: %.2f ms%n",
                lookupTest(tree, n) / 1_000_000);

        System.out.printf(
                "LinkedHashMap: %.2f ms%n",
                lookupTest(linked, n) / 1_000_000);

        System.out.println("\nCODE ORDER REPORT");

        System.out.printf(
                "HashMap: %.2f ms%n",
                codeReport(hash, false) / 1_000_000);

        System.out.printf(
                "TreeMap: %.2f ms%n",
                codeReport(tree, true) / 1_000_000);

        System.out.printf(
                "LinkedHashMap: %.2f ms%n",
                codeReport(linked, false) / 1_000_000);

        System.out.println("\nINSERTION ORDER REPORT");

        System.out.printf(
                "HashMap: %.2f ms%n",
                insertionReport(
                        hash, insertionOrder, false)
                        / 1_000_000);

        System.out.printf(
                "TreeMap: %.2f ms%n",
                insertionReport(
                        tree, insertionOrder, false)
                        / 1_000_000);

        System.out.printf(
                "LinkedHashMap: %.2f ms%n",
                insertionReport(
                        linked, insertionOrder, true)
                        / 1_000_000);

        System.out.println("\nORDER VERIFICATION");

        System.out.println(
                "HashMap code order: "
                        + checkCodeOrder(hash));

        System.out.println(
                "TreeMap code order: "
                        + checkCodeOrder(tree));

        System.out.println(
                "LinkedHashMap code order: "
                        + checkCodeOrder(linked));

        System.out.println(
                "HashMap insertion order: "
                        + checkInsertionOrder(
                                hash, insertionOrder));

        System.out.println(
                "TreeMap insertion order: "
                        + checkInsertionOrder(
                                tree, insertionOrder));

        System.out.println(
                "LinkedHashMap insertion order: "
                        + checkInsertionOrder(
                                linked, insertionOrder));
    }

    public static void main(String[] args) {

        System.out.println(
                "HOSPITAL PHARMACY MAP BENCHMARK");

        runTest(1000);
        runTest(10000);
        runTest(100000);
    }
}
