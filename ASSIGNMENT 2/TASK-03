5. Third experiment – Changing regNo after insertion
The original Student class uses final fields, which is good design because the registration number cannot change.

However, consider what happens if we remove final and allow the registration number to change.


java
import java.util.HashSet;
import java.util.Objects;
import java.util.Set;

class MutableStudent {

    String regNo;

    MutableStudent(String regNo) {
        this.regNo = regNo;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof MutableStudent)) return false;

        return regNo.equals(
                ((MutableStudent) o).regNo);
    }

    @Override
    public int hashCode() {
        return Objects.hash(regNo);
    }
}

class MutableTest {

    public static void main(String[] args) {

        Set<MutableStudent> students = new HashSet<>();

        MutableStudent s =
                new MutableStudent("192311001");

        students.add(s);

        System.out.println(
                "Before change: " + students.contains(s));

        // Change registration number
        s.regNo = "192311002";

        System.out.println(
                "After change: " + students.contains(s));

        students.add(new MutableStudent("192311002"));

        System.out.println(
                "Set size: " + students.size());
    }
}
