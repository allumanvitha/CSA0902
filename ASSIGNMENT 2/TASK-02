4. Java implementation
The following program compares ArrayList, LinkedList and ArrayDeque using the three playlist sizes.

It measures average operation time and includes all the requested operations. ArrayDeque does not support insertion at an arbitrary index, so that operation is marked as unsupported.


java

import java.util.*;

public class PlaylistBenchmark {

    static volatile long result;

    static final int[] SIZES = {1000, 10000, 100000};
    static final int ROUNDS = 5;

    static class Song {
        int id;

        Song(int id) {
            this.id = id;
        }
    }

    static ArrayList<Song> createArrayList(int n) {
        ArrayList<Song> list = new ArrayList<>();

        for (int i = 0; i < n; i++)
            list.add(new Song(i));

        return list;
    }

    static LinkedList<Song> createLinkedList(int n) {
        LinkedList<Song> list = new LinkedList<>();

        for (int i = 0; i < n; i++)
            list.add(new Song(i));

        return list;
    }

    static ArrayDeque<Song> createDeque(int n) {
        ArrayDeque<Song> deque = new ArrayDeque<>();

        for (int i = 0; i < n; i++)
            deque.addLast(new Song(i));

        return deque;
    }

    static void measure(String operation, Runnable task,
                        int operations) {

        // Warm-up
        task.run();

        long total = 0;

        for (int r = 0; r < ROUNDS; r++) {
            long start = System.nanoTime();

            task.run();

            long end = System.nanoTime();
            total += end - start;
        }

        double average =
                (double) total / (ROUNDS * operations);

        System.out.printf(
                "%-35s %.2f ns/op%n",
                operation, average);
    }

    static void testArrayList(int n) {

        int repetitions = 1000;

        System.out.println("\n--- ArrayList ---");

        // Add at end and remove from end
        ArrayList<Song> endList = createArrayList(n);

        measure("ArrayList - Add at end", () -> {
            for (int i = 0; i < repetitions; i++)
                endList.add(new Song(i));

            for (int i = 0; i < repetitions; i++)
                endList.remove(endList.size() - 1);
        }, repetitions * 2);

        // Insert and remove at front
        ArrayList<Song> frontList = createArrayList(n);

        measure("ArrayList - Insert at front", () -> {
            for (int i = 0; i < repetitions; i++)
                frontList.add(0, new Song(i));

            for (int i = 0; i < repetitions; i++)
                frontList.remove(0);
        }, repetitions * 2);

        // Insert and remove in middle
        ArrayList<Song> middleList = createArrayList(n);
        int middle = n / 2;

        measure("ArrayList - Insert in middle", () -> {
            for (int i = 0; i < repetitions; i++)
                middleList.add(middle, new Song(i));

            for (int i = 0; i < repetitions; i++)
                middleList.remove(middle);
        }, repetitions * 2);

        // Random access
        ArrayList<Song> accessList = createArrayList(n);

        measure("ArrayList - Get k-th", () -> {
            long sum = 0;

            for (int i = 0; i < repetitions; i++)
                sum += accessList.get(i % n).id;

            result = sum;
        }, repetitions);

        // Iteration
        measure("ArrayList - Full iteration", () -> {
            long sum = 0;

            for (Song s : accessList)
                sum += s.id;

            result = sum;
        }, n);
    }

    static void testLinkedList(int n) {

        int repetitions = 1000;

        System.out.println("\n--- LinkedList ---");

        LinkedList<Song> endList = createLinkedList(n);

        measure("LinkedList - Add at end", () -> {
            for (int i = 0; i < repetitions; i++)
                endList.addLast(new Song(i));

            for (int i = 0; i < repetitions; i++)
                endList.removeLast();
        }, repetitions * 2);

        LinkedList<Song> frontList = createLinkedList(n);

        measure("LinkedList - Insert at front", () -> {
            for (int i = 0; i < repetitions; i++)
                frontList.addFirst(new Song(i));

            for (int i = 0; i < repetitions; i++)
                frontList.removeFirst();
        }, repetitions * 2);

        LinkedList<Song> middleList = createLinkedList(n);
        int middle = n / 2;

        measure("LinkedList - Insert in middle", () -> {
            for (int i = 0; i < repetitions; i++) {
                ListIterator<Song> it =
                        middleList.listIterator(middle);

                it.add(new Song(i));
            }

            for (int i = 0; i < repetitions; i++) {
                ListIterator<Song> it =
                        middleList.listIterator(middle);

                it.next();
                it.remove();
            }
        }, repetitions * 2);

        LinkedList<Song> accessList = createLinkedList(n);

        measure("LinkedList - Get k-th", () -> {
            long sum = 0;

            for (int i = 0; i < repetitions; i++)
                sum += accessList.get(i % n).id;

            result = sum;
        }, repetitions);

        measure("LinkedList - Full iteration", () -> {
            long sum = 0;

            for (Song s : accessList)
                sum += s.id;

            result = sum;
        }, n);
    }

    static void testArrayDeque(int n) {

        int repetitions = 1000;

        System.out.println("\n--- ArrayDeque ---");

        ArrayDeque<Song> deque = createDeque(n);

        measure("ArrayDeque - Add at end", () -> {
            for (int i = 0; i < repetitions; i++)
                deque.addLast(new Song(i));

            for (int i = 0; i < repetitions; i++)
                deque.removeLast();
        }, repetitions * 2);

        measure("ArrayDeque - Insert at front", () -> {
            for (int i = 0; i < repetitions; i++)
                deque.addFirst(new Song(i));

            for (int i = 0; i < repetitions; i++)
                deque.removeFirst();
        }, repetitions * 2);

        System.out.println(
                "ArrayDeque - Insert in middle: NOT SUPPORTED");

        System.out.println(
                "ArrayDeque - Get k-th: NOT SUPPORTED");

        measure("ArrayDeque - Full iteration", () -> {
            long sum = 0;

            for (Song s : deque)
                sum += s.id;

            result = sum;
        }, n);
    }

    public static void main(String[] args) {

        System.out.println("MUSIC PLAYLIST PERFORMANCE TEST");

        for (int n : SIZES) {

            System.out.println("\n================================");
            System.out.println("PLAYLIST SIZE: " + n);
            System.out.println("================================");

            testArrayList(n);
            testLinkedList(n);
            testArrayDeque(n);
        }
    }
}
Execution commands

bash
javac PlaylistBenchmark.java
java PlaylistBenchmark
Note about the experiment: Each insertion/removal test performs paired operations to restore the original list size. Therefore, its reported nanoseconds per operation represent the average across both insertion and removal operations, not insertion alone. The access and iteration tests are measured separately.

For more reliable publication-quality results, JMH (Java Microbenchmark Harness) should be used to control JVM warm-up, garbage collection and measurement iterations.

