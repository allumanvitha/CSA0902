3. Java implementation
The following is a standalone Java benchmark implementing all three approaches. It measures execution time, estimates intermediate String creation, and records approximate memory usage.


java

public class RailwayTicketBenchmark {

    static volatile long resultHolder;

    // Workload configuration
    static final int ROUNDS = 5;

    // Generate ticket fields
    static String[] generateFields(int count) {
        String[] fields = new String[count];

        for (int i = 0; i < count; i++) {
            fields[i] = "Field" + i + ": PassengerDetails" + i + " | ";
        }

        return fields;
    }

    // Approach 1: Using String concatenation
    static String buildUsingString(String[] fields) {
        String ticket = "";

        for (String field : fields) {
            ticket = ticket + field;
        }

        return ticket;
    }

    // Approach 2: Using StringBuilder
    static String buildUsingStringBuilder(String[] fields) {
        StringBuilder ticket = new StringBuilder();

        for (String field : fields) {
            ticket.append(field);
        }

        return ticket.toString();
    }

    // Approach 3: Using StringBuffer
    static String buildUsingStringBuffer(String[] fields) {
        StringBuffer ticket = new StringBuffer();

        for (String field : fields) {
            ticket.append(field);
        }

        return ticket.toString();
    }

    // Measure execution time
    static void benchmark(
            String approach,
            String[] fields,
            int numberOfTickets,
            int rounds) {

        long totalTime = 0;
        long checksum = 0;

        // Warm-up
        for (int i = 0; i < 2; i++) {
            buildUsingStringBuilder(fields);
        }

        for (int r = 0; r < rounds; r++) {

            long start = System.nanoTime();

            for (int i = 0; i < numberOfTickets; i++) {

                String ticket;

                switch (approach) {
                    case "String":
                        ticket = buildUsingString(fields);
                        break;

                    case "StringBuilder":
                        ticket = buildUsingStringBuilder(fields);
                        break;

                    case "StringBuffer":
                        ticket = buildUsingStringBuffer(fields);
                        break;

                    default:
                        throw new IllegalArgumentException(
                                "Unknown approach");
                }

                // Consume output to ensure actual construction
                checksum += ticket.hashCode();
            }

            long end = System.nanoTime();
            totalTime += (end - start);
        }

        resultHolder = checksum;

        double averageTime =
                (double) totalTime / rounds / 1_000_000;

        System.out.printf(
                "%-15s Average time: %.3f ms%n",
                approach, averageTime);
    }

    // Approximate memory measurement
    static long getUsedMemory() {
        Runtime runtime = Runtime.getRuntime();
        return runtime.totalMemory() - runtime.freeMemory();
    }

    static void runWorkload(
            String workload,
            int tickets,
            int fieldCount) {

        System.out.println("\n================================");
        System.out.println(workload);
        System.out.println("Tickets: " + tickets);
        System.out.println("Fields per ticket: " + fieldCount);
        System.out.println("================================");

        String[] fields = generateFields(fieldCount);

        // Check that all approaches produce identical output
        String s1 = buildUsingString(fields);
        String s2 = buildUsingStringBuilder(fields);
        String s3 = buildUsingStringBuffer(fields);

        System.out.println("Outputs identical: "
                + (s1.equals(s2) && s2.equals(s3)));

        // Estimated intermediate String objects
        long stringObjects =
                (long) tickets * (fieldCount - 1);

        long builderFinalStrings = tickets;
        long bufferFinalStrings = tickets;

        System.out.println(
                "Estimated String concatenation results: "
                        + stringObjects);

        System.out.println(
                "Builder final Strings: " + builderFinalStrings);

        System.out.println(
                "Buffer final Strings: " + bufferFinalStrings);

        long memoryBefore = getUsedMemory();

        benchmark("String", fields, tickets, ROUNDS);
        benchmark("StringBuilder", fields, tickets, ROUNDS);
        benchmark("StringBuffer", fields, tickets, ROUNDS);

        long memoryAfter = getUsedMemory();

        System.out.printf(
                "Approximate heap change: %.2f KB%n",
                (memoryAfter - memoryBefore) / 1024.0);
    }

    public static void main(String[] args) {

        System.out.println("RAILWAY E-TICKET GENERATION");
        System.out.println("JAVA STRING PERFORMANCE TEST");

        // Workload 1: Small ticket
        runWorkload("WORKLOAD 1 - SMALL TICKET",
                1, 6);

        // Workload 2: Many tickets
        runWorkload("WORKLOAD 2 - HIGH LOAD",
                10000, 50);

        // Workload 3: Large tickets
        runWorkload("WORKLOAD 3 - LARGE TICKETS",
                2000, 500);
    }
}
